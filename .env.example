# Environment Variables
# Copy this file to .env and fill in your values
# Then add these to Vercel Dashboard -> Project Settings -> Environment Variables

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/fashion_store?retryWrites=true&w=majority

# JWT Secret (use a long random string - you can generate one at https://jwtsecret.com/)
JWT_SECRET=your_super_long_random_secret_here_change_this

# Groq API Key (for AI features if used)
GROQ_API_KEY=your_groq_api_key_here
